ui = true

listener "tcp" {
  address         = "0.0.0.0:{{ openbao_port }}"
  cluster_address = "0.0.0.0:{{ openbao_cluster_port }}"
{% if openbao_tls_disable %}
  tls_disable = true
{% else %}
  tls_cert_file   = "{{ openbao_config_dir }}/tls/openbao.crt"
  tls_key_file    = "{{ openbao_config_dir }}/tls/openbao.key"
  tls_min_version = "tls13"
{% endif %}
}

storage "file" {
  path = "{{ openbao_data_dir }}"
}

api_addr     = "{{ openbao_api_addr }}"
cluster_addr = "{{ openbao_cluster_addr }}"
disable_mlock = false
